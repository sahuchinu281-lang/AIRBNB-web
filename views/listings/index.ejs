
<% layout("layouts/boilerplate") -%>

<%
const listings = (
    typeof allListings !== "undefined" &&
    Array.isArray(allListings)
) ? allListings : [];

const categories = [
    { name: "Trending", value: "all", icon: "fa-fire" },
    { name: "Rooms", value: "Rooms", icon: "fa-bed" },
    { name: "Iconic Cities", value: "Iconic Cities", icon: "fa-city" },
    { name: "Mountains", value: "Mountains", icon: "fa-mountain-sun" },
    { name: "Castles", value: "Castles", icon: "fa-chess-rook" },
    { name: "Amazing Pools", value: "Amazing Pools", icon: "fa-person-swimming" },
    { name: "Farm Houses", value: "Farm Houses", icon: "fa-tractor" },
    { name: "Cabins", value: "Cabins", icon: "fa-house" },
    { name: "Beachfront", value: "Beachfront", icon: "fa-umbrella-beach" },
    { name: "Tiny Homes", value: "Tiny Homes", icon: "fa-house-chimney" },
    { name: "Camping", value: "Camping", icon: "fa-campground" },
    { name: "Countryside", value: "Countryside", icon: "fa-wheat-awn" },
    { name: "Treehouses", value: "Treehouses", icon: "fa-tree" },
    { name: "Lakefront", value: "Lakefront", icon: "fa-water" },
    { name: "Luxury Stays", value: "Luxury Stays", icon: "fa-gem" },
    { name: "Desert Homes", value: "Desert Homes", icon: "fa-sun" },
    { name: "Ski Resorts", value: "Ski Resorts", icon: "fa-person-skiing" },
    { name: "Historic Homes", value: "Historic Homes", icon: "fa-landmark" }
];
%>

<!-- HERO -->
<section class="stay-hero">
    <div class="stay-hero-content">
        <span class="stay-eyebrow">
            <i class="fa-solid fa-compass"></i>
            YOUR NEXT ADVENTURE STARTS HERE
        </span>

        <h1>Find your place<br>in the world.</h1>

        <p>
            Extraordinary places, beautiful destinations,
            and memories waiting to happen.
        </p>

        <form id="listingSearch" class="stay-search">
            <div class="stay-search-field">
                <i class="fa-solid fa-location-dot"></i>
                <div>
                    <label for="searchDestination">Where to?</label>
                    <input id="searchDestination" type="search"
                           placeholder="Search destination or stay">
                </div>
            </div>

            <div class="stay-search-field">
                <i class="fa-solid fa-indian-rupee-sign"></i>
                <div>
                    <label for="searchBudget">Maximum budget</label>
                    <input id="searchBudget" type="number"
                           min="0" placeholder="Any price">
                </div>
            </div>

            <button type="submit" class="stay-search-submit">
                <i class="fa-solid fa-magnifying-glass"></i>
                Search
            </button>
        </form>
    </div>

    <div class="stay-hero-art" aria-hidden="true">
        <div class="hero-orbit hero-orbit-one"></div>
        <div class="hero-orbit hero-orbit-two"></div>
        <div class="hero-art-card">
            <i class="fa-solid fa-mountain-sun"></i>
            <span>Somewhere beautiful</span>
            <small>Your next chapter awaits</small>
        </div>
        <div class="hero-floating-icon hero-floating-one">
            <i class="fa-solid fa-heart"></i>
        </div>
        <div class="hero-floating-icon hero-floating-two">
            <i class="fa-solid fa-location-dot"></i>
        </div>
    </div>
</section>

<!-- PAGE HEADING -->
<section class="stay-section-heading">
    <div>
        <span class="stay-section-kicker">EXPLORE THE COLLECTION</span>
        <h2>Discover your next stay</h2>
        <p>Find the perfect place for your kind of getaway.</p>
    </div>

    <a href="/listings/new" class="stay-add-button">
        <i class="fa-solid fa-plus"></i>
        Add listing
    </a>
</section>

<!-- ALL 18 CATEGORIES -->
<nav class="stay-category-toolbar" aria-label="Stay categories">
    <div class="stay-category-bar" id="categoryBar">
        <% categories.forEach((category, index) => { %>
            <button type="button"
                    class="stay-category <%= index === 0 ? 'active' : '' %>"
                    data-category="<%= category.value %>">
                <i class="fa-solid <%= category.icon %>"></i>
                <span><%= category.name %></span>
            </button>
        <% }) %>
    </div>

    <button type="button" class="stay-filter-button"
            data-bs-toggle="modal" data-bs-target="#filterModal">
        <i class="fa-solid fa-sliders"></i>
        Filters
    </button>
</nav>

<!-- FILTER MODAL -->
<div class="modal fade" id="filterModal" tabindex="-1"
     aria-labelledby="filterModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content stay-modal">

            <div class="modal-header">
                <h5 class="modal-title" id="filterModalLabel">
                    <i class="fa-solid fa-sliders me-2"></i>
                    Find your perfect stay
                </h5>
                <button type="button" class="btn-close"
                        data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <div class="modal-body">
                <div class="stay-filter-section">
                    <h6>Price per night</h6>
                    <p>Set a budget that works for you.</p>

                    <div class="row g-3">
                        <div class="col-6">
                            <label for="minPrice" class="form-label">
                                Minimum price (₹)
                            </label>
                            <input type="number" id="minPrice" min="0"
                                   class="form-control" placeholder="No minimum">
                        </div>
                        <div class="col-6">
                            <label for="maxPrice" class="form-label">
                                Maximum price (₹)
                            </label>
                            <input type="number" id="maxPrice" min="0"
                                   class="form-control" placeholder="No maximum">
                        </div>
                    </div>
                </div>

                <hr>

                <div class="stay-filter-section">
                    <h6>Accommodation type</h6>
                    <p>Choose the style of stay you want.</p>

                    <select id="filterCategory" class="form-select">
                        <% categories.forEach((category) => { %>
                            <option value="<%= category.value %>">
                                <%= category.name %>
                            </option>
                        <% }) %>
                    </select>
                </div>

                <p id="filterError" class="text-danger small mt-3 mb-0"
                   role="alert"></p>
            </div>

            <div class="modal-footer">
                <button type="button" id="clearFilters"
                        class="btn btn-light">Clear all</button>
                <button type="button" id="applyFilters"
                        class="btn btn-dark">Show stays</button>
            </div>
        </div>
    </div>
</div>

<!-- LISTINGS RESULTS -->
<div class="stay-results-toolbar">
    <p id="filterResults" aria-live="polite">
        Explore available stays
    </p>

    <div class="stay-sort-control">
        <label for="sortListings">
            <i class="fa-solid fa-arrow-down-wide-short"></i>
            Sort
        </label>
        <select id="sortListings">
            <option value="recommended">Recommended</option>
            <option value="price-low">Price: low to high</option>
            <option value="price-high">Price: high to low</option>
            <option value="name">Name: A to Z</option>
        </select>
    </div>
</div>

<div class="row row-cols-1 row-cols-sm-2 row-cols-lg-3 row-cols-xl-4 g-4"
     id="listingsGrid">

    <% listings.forEach((listing) => { %>
        <div class="col stay-listing-column"
             data-category="<%= listing.category || '' %>"
             data-price="<%= Number(listing.price || 0) %>"
             data-title="<%= listing.title || '' %>"
             data-location="<%= listing.location || '' %>"
             data-country="<%= listing.country || '' %>">

            <article class="stay-listing-card h-100">
                <div class="stay-listing-image-wrap">
                    <a href="/listings/<%= listing._id %>"
                       class="stay-listing-image-link">
                        <img
                            src="<%= listing.image?.url || 'https://placehold.co/600x450?text=Beautiful+Stay' %>"
                            alt="<%= listing.title || 'Listing image' %>"
                            class="stay-listing-image"
                            loading="lazy"
                            onerror="this.onerror=null;this.src='https://placehold.co/600x450?text=Image+Unavailable';">
                    </a>

                    <span class="stay-image-badge">
                        <i class="fa-solid fa-sparkles"></i>
                        Discover
                    </span>

                    <button type="button"
                            class="stay-favorite"
                            aria-label="Add to favorites"
                            aria-pressed="false">
                        <i class="fa-regular fa-heart"></i>
                    </button>
                </div>

                <div class="stay-listing-body">
                    <div class="stay-listing-location">
                        <i class="fa-solid fa-location-dot"></i>
                        <span>
                            <%= listing.location || "Location unavailable" %>
                            <% if (listing.country) { %>
                                , <%= listing.country %>
                            <% } %>
                        </span>
                    </div>

                    <h3 class="stay-listing-title">
                        <a href="/listings/<%= listing._id %>">
                            <%= listing.title || "Untitled Listing" %>
                        </a>
                    </h3>

                    <p class="stay-listing-category">
                        <%= listing.category || "Unique stay" %>
                    </p>

                    <div class="stay-listing-footer">
                        <p class="stay-listing-price">
                            <strong>₹<%= Number(listing.price || 0).toLocaleString("en-IN") %></strong>
                            <span>/ night</span>
                        </p>

                        <a href="/listings/<%= listing._id %>"
                           class="stay-view-link"
                           aria-label="View listing details">
                            <i class="fa-solid fa-arrow-up-right-from-square"></i>
                        </a>
                    </div>
                </div>
            </article>
        </div>
    <% }) %>
</div>

<!-- NO RESULTS -->
<div id="emptyState" class="stay-empty-state d-none">
    <div class="stay-empty-icon">
        <i class="fa-solid fa-house-circle-check"></i>
    </div>
    <h3>No stays found</h3>
    <p>Try another destination or change your filters.</p>
    <button type="button" id="resetEmptyFilters" class="btn btn-dark">
        Reset search
    </button>
</div>

<% if (listings.length === 0) { %>
    <div class="stay-empty-state stay-initial-empty">
        <div class="stay-empty-icon">
            <i class="fa-solid fa-house"></i>
        </div>
        <h3>Your next adventure starts here</h3>
        <p>There are no listings yet. Add your first beautiful stay.</p>
        <a href="/listings/new" class="btn btn-dark">
            <i class="fa-solid fa-plus me-2"></i>
            Create first listing
        </a>
    </div>
<% } %>

<!-- POPULAR DESTINATIONS -->
<section class="stay-extra-section" id="destinations">
    <div class="stay-section-heading">
        <div>
            <span class="stay-section-kicker">PLACES TO FALL IN LOVE WITH</span>
            <h2>Popular destinations</h2>
            <p>Start with a place you've always wanted to explore.</p>
        </div>
        <a href="#listingsGrid" class="stay-text-link">Explore stays
            <i class="fa-solid fa-arrow-right"></i>
        </a>
    </div>

    <div class="stay-destination-grid">
        <button type="button" class="stay-destination-card"
                data-destination="Goa">
            <img src="https://images.unsplash.com/photo-1512343879784-a960bf40e7f2?auto=format&fit=crop&w=700&q=80"
                 alt="Goa coastline" loading="lazy">
            <span><strong>Goa</strong><small>Beaches and sunsets</small></span>
        </button>

        <button type="button" class="stay-destination-card"
                data-destination="Manali">
            <img src="https://images.unsplash.com/photo-1626621341517-bbf3d9990a23?auto=format&fit=crop&w=700&q=80"
                 alt="Manali mountains" loading="lazy">
            <span><strong>Manali</strong><small>Mountain escapes</small></span>
        </button>

        <button type="button" class="stay-destination-card"
                data-destination="Jaipur">
            <img src="https://images.unsplash.com/photo-1599661046827-dacff0c0f09a?auto=format&fit=crop&w=700&q=80"
                 alt="Jaipur heritage architecture" loading="lazy">
            <span><strong>Jaipur</strong><small>Culture and heritage</small></span>
        </button>

        <button type="button" class="stay-destination-card"
                data-destination="Mumbai">
            <img src="https://images.unsplash.com/photo-1570168007204-dfb528c6958f?auto=format&fit=crop&w=700&q=80"
                 alt="Mumbai city" loading="lazy">
            <span><strong>Mumbai</strong><small>City adventures</small></span>
        </button>
    </div>
</section>

<!-- FEATURED BANNER -->
<section class="stay-getaway-banner">
    <div class="stay-getaway-content">
        <span>MAKE TIME FOR YOURSELF</span>
        <h2>Some places stay<br>with you forever.</h2>
        <p>Find a new view, a slower morning, and a reason to explore.</p>
        <a href="#listingsGrid" class="stay-getaway-button">
            Find your getaway <i class="fa-solid fa-arrow-right"></i>
        </a>
    </div>
    <div class="stay-getaway-art" aria-hidden="true">
        <i class="fa-solid fa-mountain-sun"></i>
    </div>
</section>

<!-- WHY CHOOSE US -->
<section class="stay-extra-section">
    <div class="stay-section-heading">
        <div>
            <span class="stay-section-kicker">MADE FOR YOUR JOURNEY</span>
            <h2>Travel your way</h2>
            <p>Everything you need to find a stay that feels right.</p>
        </div>
    </div>

    <div class="stay-benefits-grid">
        <article class="stay-benefit-card">
            <div><i class="fa-solid fa-house"></i></div>
            <h3>Unique places</h3>
            <p>Explore different kinds of accommodation for every kind of trip.</p>
        </article>

        <article class="stay-benefit-card">
            <div><i class="fa-solid fa-magnifying-glass"></i></div>
            <h3>Easy discovery</h3>
            <p>Find stays by destination, category, and the price you prefer.</p>
