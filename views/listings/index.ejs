<!-- ALL PAGE JAVASCRIPT IS KEPT IN THIS FILE -->
<script>
document.addEventListener("DOMContentLoaded", function () {
    const grid = document.getElementById("listingsGrid");
    const cards = Array.from(document.querySelectorAll(".stay-listing-column"));
    const categoryButtons = document.querySelectorAll(".stay-category");
    const categorySelect = document.getElementById("filterCategory");
    const destinationInput = document.getElementById("searchDestination");
    const budgetInput = document.getElementById("searchBudget");
    const minInput = document.getElementById("minPrice");
    const maxInput = document.getElementById("maxPrice");
    const sortSelect = document.getElementById("sortListings");
    const results = document.getElementById("filterResults");
    const emptyState = document.getElementById("emptyState");
    const filterError = document.getElementById("filterError");

    let activeCategory = "all";
    let searchText = "";
    let searchBudget = Infinity;

    function updateCategoryButtons() {
        categoryButtons.forEach(function (button) {
            button.classList.toggle(
                "active",
                button.dataset.category === activeCategory
            );
        });
    }

    function applyFilters() {
        const min = minInput.value === "" ? 0 : Number(minInput.value);
        const max = maxInput.value === "" ? Infinity : Number(maxInput.value);

        if (!Number.isFinite(min) || min < 0 ||
            (max !== Infinity && (!Number.isFinite(max) || max < 0)) ||
            min > max) {
            filterError.textContent = "Enter a valid price range.";
            return false;
        }

        filterError.textContent = "";
        const visibleCards = [];

        cards.forEach(function (card) {
            const category = (card.dataset.category || "").trim().toLowerCase();
            const title = (card.dataset.title || "").toLowerCase();
            const location = (card.dataset.location || "").toLowerCase();
            const country = (card.dataset.country || "").toLowerCase();
            const price = Number(card.dataset.price);

            const categoryMatch =
                activeCategory === "all" ||
                category === activeCategory.toLowerCase();

            const destinationMatch =
                !searchText || title.includes(searchText) ||
                location.includes(searchText) || country.includes(searchText);

            const priceMatch =
                Number.isFinite(price) &&
                price >= min && price <= max && price <= searchBudget;

            const visible = categoryMatch && destinationMatch && priceMatch;
            card.classList.toggle("d-none", !visible);

            if (visible) visibleCards.push(card);
        });

        visibleCards.sort(function (a, b) {
            const priceA = Number(a.dataset.price);
            const priceB = Number(b.dataset.price);
            const titleA = (a.dataset.title || "").toLowerCase();
            const titleB = (b.dataset.title || "").toLowerCase();

            if (sortSelect.value === "price-low") return priceA - priceB;
            if (sortSelect.value === "price-high") return priceB - priceA;
            if (sortSelect.value === "name") return titleA.localeCompare(titleB);

            return cards.indexOf(a) - cards.indexOf(b);
        });

        visibleCards.forEach(card => grid.appendChild(card));

        results.textContent =
            "Showing " + visibleCards.length + " of " + cards.length + " stays";

        emptyState.classList.toggle(
            "d-none",
            visibleCards.length !== 0 || cards.length === 0
        );

        return true;
    }

    categoryButtons.forEach(function (button) {
        button.addEventListener("click", function () {
            activeCategory = button.dataset.category;
            categorySelect.value = activeCategory;
            updateCategoryButtons();
            applyFilters();
            document.getElementById("listingsGrid").scrollIntoView({
                behavior: "smooth", block: "start"
            });
        });
    });

    categorySelect.addEventListener("change", function () {
        activeCategory = categorySelect.value;
        updateCategoryButtons();
    });

    document.getElementById("listingSearch").addEventListener("submit", function (event) {
        event.preventDefault();
        const budget = budgetInput.value;

        if (budget !== "" &&
            (!Number.isFinite(Number(budget)) || Number(budget) < 0)) {
            results.textContent = "Please enter a valid maximum budget.";
            return;
        }

        searchText = destinationInput.value.trim().toLowerCase();
        searchBudget = budget === "" ? Infinity : Number(budget);
        applyFilters();
    });

    sortSelect.addEventListener("change", applyFilters);

    document.getElementById("applyFilters").addEventListener("click", function () {
        if (applyFilters() && window.bootstrap) {
            const modal = bootstrap.Modal.getInstance(document.getElementById("filterModal"));
            if (modal) modal.hide();
        }
    });

    function clearFilters() {
        minInput.value = "";
        maxInput.value = "";
        budgetInput.value = "";
        destinationInput.value = "";
        searchText = "";
        searchBudget = Infinity;
        activeCategory = "all";
        categorySelect.value = "all";
        sortSelect.value = "recommended";
        updateCategoryButtons();
        applyFilters();
    }

    document.getElementById("clearFilters").addEventListener("click", clearFilters);
    document.getElementById("resetEmptyFilters").addEventListener("click", clearFilters);

    document.querySelectorAll(".stay-favorite").forEach(function (button) {
        button.addEventListener("click", function () {
            const active = button.getAttribute("aria-pressed") === "true";
            button.setAttribute("aria-pressed", String(!active));
            button.classList.toggle("is-favorite", !active);
            button.innerHTML = !active
                ? '<i class="fa-solid fa-heart"></i>'
                : '<i class="fa-regular fa-heart"></i>';
            button.setAttribute("aria-label",
                !active ? "Remove from favorites" : "Add to favorites");
        });
    });

    function searchDestination(destination) {
        destinationInput.value = destination;
        searchText = destination.toLowerCase();
        searchBudget = Infinity;
        budgetInput.value = "";
        applyFilters();
        document.getElementById("listingsGrid").scrollIntoView({
            behavior: "smooth", block: "start"
        });
    }

    document.querySelectorAll(".stay-destination-card").forEach(function (button) {
        button.addEventListener("click", function () {
            searchDestination(button.dataset.destination);
        });
    });

    document.querySelectorAll(".stay-inspiration-card").forEach(function (button) {
        button.addEventListener("click", function () {
            activeCategory = button.dataset.inspiration;
            categorySelect.value = activeCategory;
            updateCategoryButtons();
            applyFilters();
            document.getElementById("listingsGrid").scrollIntoView({
                behavior: "smooth", block: "start"
            });
        });
    });

    document.getElementById("newsletterForm").addEventListener("submit", function (event) {
        event.preventDefault();
