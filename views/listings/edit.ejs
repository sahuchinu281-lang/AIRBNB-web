<% layout("layouts/boilerplate") -%>

<div class="row justify-content-center py-4">
    <div class="col-lg-8 col-xl-7">

        <div class="card border-0 shadow-sm">
            <div class="card-body p-4 p-md-5">

                <div class="mb-4">
                    <h2 class="fw-bold">
                        <i class="fa-solid fa-pen-to-square me-2"></i>
                        Edit Listing
                    </h2>
                    <p class="text-muted mb-0">
                        Update your listing details and property image.
                    </p>
                </div>

                <form
                    action="/listings/<%= listing._id %>?_method=PUT"
                    method="POST"
                    enctype="multipart/form-data"
                    class="needs-validation"
                    novalidate
                >

                    <!-- Title -->
                    <div class="mb-3">
                        <label for="title" class="form-label fw-semibold">
                            Listing Title
                        </label>
                        <input
                            id="title"
                            name="listing[title]"
                            type="text"
                            class="form-control"
                            value="<%= listing.title %>"
                            minlength="3"
                            maxlength="100"
                            required
                        >
                        <div class="invalid-feedback">
                            Enter a title between 3 and 100 characters.
                        </div>
                    </div>

                    <!-- Description -->
                    <div class="mb-3">
                        <label for="description" class="form-label fw-semibold">
                            Description
                        </label>
                        <textarea
                            id="description"
                            name="listing[description]"
                            class="form-control"
                            rows="4"
                            maxlength="5000"
                            required
                        ><%= listing.description || "" %></textarea>
                        <div class="invalid-feedback">
                            Please enter a description.
                        </div>
                    </div>

                    <div class="row">
                        <!-- Price -->
                        <div class="col-md-6 mb-3">
                            <label for="price" class="form-label fw-semibold">
                                Price per Night (₹)
                            </label>
                            <input
                                id="price"
                                name="listing[price]"
                                type="number"
                                class="form-control"
                                min="0"
                                step="0.01"
                                value="<%= listing.price %>"
                                required
                            >
                            <div class="invalid-feedback">
                                Enter a valid non-negative price.
                            </div>
                        </div>

                        <!-- Country -->
                        <div class="col-md-6 mb-3">
                            <label for="country" class="form-label fw-semibold">
                                Country
                            </label>
                            <input
                                id="country"
                                name="listing[country]"
                                type="text"
                                class="form-control"
                                value="<%= listing.country %>"
                                required
                            >
                            <div class="invalid-feedback">
                                Enter a country.
                            </div>
                        </div>
                    </div>

                    <!-- Location -->
                    <div class="mb-3">
                        <label for="location" class="form-label fw-semibold">
                            Location
                        </label>
                        <input
                            id="location"
                            name="listing[location]"
                            type="text"
                            class="form-control"
                            value="<%= listing.location %>"
                            required
                        >
                        <div class="invalid-feedback">
                            Enter a location.
                        </div>
                    </div>

                    <!-- Current Image -->
                    <div class="mb-3">
                        <label class="form-label fw-semibold">
                            Current Listing Image
                        </label>

                        <div class="mb-3">
                            <img
                                src="<%= listing.image?.url || 'https://placehold.co/800x400?text=No+Image' %>"
                                alt="Current listing image"
                                class="img-fluid rounded border d-block"
                                style="max-height: 280px; object-fit: cover;"
                            >
                        </div>

                        <!-- Replace Image -->
                        <label for="imageFile" class="form-label fw-semibold">
                            Replace Image (Optional)
                        </label>

                        <input
                            id="imageFile"
                            name="listingImage"
                            type="file"
                            class="form-control"
                            accept="image/jpeg,image/png,image/webp"
                        >

                        <div class="form-text">
                            JPG, PNG, or WebP. Maximum size: 5 MB.
                            Leave empty to keep the current image.
                        </div>

                        <div
                            id="imageError"
                            class="text-danger small mt-2"
                            role="alert"
                        ></div>

                        <!-- Replacement Preview -->
                        <div id="previewContainer" class="mt-3 d-none">
                            <p class="small fw-semibold mb-2">
                                New Image Preview
                            </p>

                            <img
                                id="imagePreview"
                                alt="Replacement image preview"
                                class="img-fluid rounded border"
                                style="max-height: 280px;"
                            >

                            <div>
                                <button
                                    type="button"
                                    id="removeImage"
                                    class="btn btn-outline-danger btn-sm mt-2"
                                >
                                    <i class="fa-solid fa-xmark me-1"></i>
                                    Cancel Replacement
                                </button>
                            </div>
                        </div>
                    </div>

                    <!-- Buttons -->
                    <div class="d-flex flex-wrap gap-2 mt-4">
                        <button type="submit" class="btn btn-dark">
                            <i class="fa-solid fa-floppy-disk me-2"></i>
                            Save Changes
                        </button>

                        <a
                            href="/listings/<%= listing._id %>"
                            class="btn btn-outline-secondary"
                        >
                            Cancel
                        </a>
                    </div>

                </form>
            </div>
        </div>

    </div>
</div>
