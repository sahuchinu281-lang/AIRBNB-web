<% layout("layouts/boilerplate") -%>

<div class="row justify-content-center">
    <div class="col-lg-9">

        <!-- Listing Title -->
        <div class="d-flex justify-content-between align-items-start mb-3">
            <div>
                <h2 class="fw-bold mb-2"><%= listing.title %></h2>
                <p class="text-muted mb-0">
                    <i class="fa-solid fa-location-dot me-1"></i>
                    <%= listing.location %>, <%= listing.country %>
                </p>
            </div>
        </div>

        <!-- Listing Image -->
        <div class="mb-4">
            <img
                src="<%= listing.image?.url || 'https://placehold.co/1000x600?text=No+Image' %>"
                alt="<%= listing.title %>"
                class="img-fluid rounded-4 w-100"
                style="max-height: 480px; object-fit: cover;"
            >
        </div>

        <!-- Listing Information -->
        <div class="card border-0 shadow-sm mb-4">
            <div class="card-body p-4">
                <h4 class="fw-bold mb-3">
                    <i class="fa-solid fa-house me-2"></i>
                    About this place
                </h4>

                <p class="text-muted">
                    <%= listing.description || "No description available." %>
                </p>

                <hr>

                <h4 class="fw-bold">
                    ₹<%= Number(listing.price).toLocaleString("en-IN") %>
                    <span class="fs-6 fw-normal text-muted">/ night</span>
                </h4>

                <% if (listing.owner) { %>
                    <p class="text-muted mb-0">
                        Hosted by
                        <strong><%= listing.owner.username || "Host" %></strong>
                    </p>
                <% } %>
            </div>
        </div>

        <!-- Edit and Delete Listing -->
        <% if (
            currentUser &&
            listing.owner &&
            listing.owner._id.toString() === currentUser._id.toString()
        ) { %>

            <div class="d-flex gap-2 mb-4">
                <a href="/listings/<%= listing._id %>/edit"
                   class="btn btn-dark">
                    <i class="fa-solid fa-pen me-1"></i>
                    Edit Listing
                </a>

                <form
                    action="/listings/<%= listing._id %>?_method=DELETE"
                    method="POST"
                    onsubmit="return confirm('Are you sure you want to delete this listing?');"
                >
                    <button type="submit" class="btn btn-outline-danger">
                        <i class="fa-solid fa-trash me-1"></i>
                        Delete Listing
                    </button>
                </form>
            </div>
        <% } %>

        <!-- Map -->
        <hr class="my-4">

        <h3 class="fw-bold mb-2">Where you'll be</h3>
        <p class="text-muted">
            <%= listing.location %>, <%= listing.country %>
        </p>

        <div
            id="map"
            data-token="<%= typeof mapToken !== 'undefined' ? mapToken : '' %>"
            data-coordinates="<%= JSON.stringify(listing.geometry?.coordinates || []) %>"
            data-title="<%= listing.title %>"
            style="width: 100%; height: 400px; border-radius: 12px;"
        ></div>

        <p id="map-error" class="text-danger small mt-2"></p>

        <!-- Reviews -->
        <hr class="my-5">

        <h3 class="fw-bold mb-4">
            <i class="fa-solid fa-star me-2"></i>
            Reviews
        </h3>

        <% if (listing.reviews && listing.reviews.length > 0) { %>
            <div class="row g-3">
                <% listing.reviews.forEach(review => { %>
                    <div class="col-md-6">
                        <div class="card h-100 border-0 shadow-sm">
                            <div class="card-body">
                                <h6 class="fw-bold">
                                    <%= review.username || "Guest" %>
                                </h6>

                                <p class="text-warning mb-2">
                                    <% for (let i = 0; i < Number(review.rating || 0); i++) { %>
                                        <i class="fa-solid fa-star"></i>
                                    <% } %>
                                    <% for (let i = Number(review.rating || 0); i < 5; i++) { %>
                                        <i class="fa-regular fa-star"></i>
                                    <% } %>
                                </p>

                                <p class="text-muted mb-2">
                                    <%= review.comment %>
                                </p>

                                <% if (
                                    currentUser &&
                                    review.author &&
                                    review.author._id &&
                                    review.author._id.toString() === currentUser._id.toString()
                                ) { %>
                                    <div class="d-flex gap-2 mt-3">
                                        <a
                                            href="/listings/<%= listing._id %>/reviews/<%= review._id %>/edit"
                                            class="btn btn-sm btn-outline-dark"
                                        >
                                            Edit
                                        </a>

                                        <form
                                            action="/listings/<%= listing._id %>/reviews/<%= review._id %>?_method=DELETE"
                                            method="POST"
                                            onsubmit="return confirm('Delete this review?');"
                                        >
                                            <button
                                                type="submit"
                                                class="btn btn-sm btn-outline-danger"
                                            >
                                                Delete
                                            </button>
                                        </form>
                                    </div>
                                <% } %>
                            </div>
                        </div>
                    </div>
                <% }) %>
            </div>
        <% } else { %>
            <p class="text-muted">
                No reviews yet. Be the first to leave one!
            </p>
        <% } %>

        <!-- Write Review Form -->
        <hr class="my-4">

        <% if (currentUser) { %>
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-body p-4">
                    <h4 class="fw-bold mb-3">
                        <i class="fa-solid fa-pen-to-square me-2"></i>
                        Write a Review
                    </h4>

                    <form
                        action="/listings/<%= listing._id %>/reviews"
                        method="POST"
                    >
                        <div class="mb-3">
                            <label for="rating" class="form-label">
                                Rating
                            </label>

                            <select
                                id="rating"
                                name="review[rating]"
                                class="form-select"
                                required
                            >
                                <option value="">Choose a rating</option>
                                <option value="1">★☆☆☆☆ - 1 Star</option>
                                <option value="2">★★☆☆☆ - 2 Stars</option>
                                <option value="3">★★★☆☆ - 3 Stars</option>
                                <option value="4">★★★★☆ - 4 Stars</option>
                                <option value="5">★★★★★ - 5 Stars</option>
                            </select>
                        </div>

                        <div class="mb-3">
                            <label for="comment" class="form-label">
                                Your Comment
                            </label>

                            <textarea
                                id="comment"
                                name="review[comment]"
                                class="form-control"
                                rows="4"
                                minlength="1"
                                maxlength="1000"
                                placeholder="Share your experience..."
                                required
                            ></textarea>
                        </div>

                        <button type="submit" class="btn btn-dark">
                            Submit Review
                        </button>
                    </form>
                </div>
            </div>
        <% } else { %>
            <div class="alert alert-light border mb-4">
                <a href="/login" class="alert-link">Log in</a>
                to write a review.
            </div>
        <% } %>

        <a href="/listings" class="btn btn-outline-secondary mb-5">
            Back to Listings
        </a>

    </div>
</div>


