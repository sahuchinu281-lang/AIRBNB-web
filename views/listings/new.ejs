<% layout("layouts/boilerplate") -%>

<div class="row justify-content-center py-4">
    <div class="col-lg-8 col-xl-7">

        <div class="card border-0 shadow-sm">
            <div class="card-body p-4 p-md-5">

                <div class="mb-4">
                    <h2 class="fw-bold">
                        <i class="fa-solid fa-house-circle-check me-2"></i>
                        Create a New Listing
                    </h2>
                    <p class="text-muted mb-0">
                        Add your property details to publish a new listing.
                    </p>
                </div>

                <form
                    action="/listings"
                    method="POST"
                    enctype="multipart/form-data"
                    class="needs-validation"
                    novalidate
                >

                    <!-- Listing Title -->
                    <div class="mb-3">
                        <label for="title" class="form-label fw-semibold">
                            Listing Title
                        </label>
                        <input
                            id="title"
                            name="listing[title]"
                            type="text"
                            class="form-control"
                            placeholder="e.g. Cozy apartment near the beach"
                            minlength="3"
                            maxlength="100"
                            required
                        >
                        <div class="invalid-feedback">
                            Enter a title between 3 and 100 characters.
                        </div>
                    </div>

                    <!-- Description -->
                    <div class="mb-3">
                        <label for="description" class="form-label fw-semibold">
                            Description
                        </label>
                        <textarea
                            id="description"
                            name="listing[description]"
                            class="form-control"
                            rows="4"
                            maxlength="5000"
                            placeholder="Describe the property, amenities, and nearby attractions."
                            required
                        ></textarea>
                        <div class="invalid-feedback">
                            Please enter a description.
                        </div>
                    </div>

                    <div class="row">
                        <!-- Price -->
                        <div class="col-md-6 mb-3">
                            <label for="price" class="form-label fw-semibold">
                                Price per Night (₹)
                            </label>
                            <input
                                id="price"
                                name="listing[price]"
                                type="number"
                                class="form-control"
                                placeholder="e.g. 2500"
                                min="0"
                                step="0.01"
                                required
                            >
                            <div class="invalid-feedback">
                                Enter a valid non-negative price.
                            </div>
                        </div>

                        <!-- Country -->
                        <div class="col-md-6 mb-3">
                            <label for="country" class="form-label fw-semibold">
                                Country
                            </label>
                            <input
                                id="country"
                                name="listing[country]"
                                type="text"
                                class="form-control"
                                placeholder="e.g. India"
                                required
                            >
                            <div class="invalid-feedback">
                                Enter the country.
                            </div>
                        </div>
                    </div>

                    <!-- Location -->
                    <div class="mb-3">
                        <label for="location" class="form-label fw-semibold">
                            Location
                        </label>
                        <input
                            id="location"
                            name="listing[location]"
                            type="text"
                            class="form-control"
                            placeholder="e.g. Bengaluru, Karnataka"
                            required
                        >
                        <div class="invalid-feedback">
                            Enter the property location.
                        </div>
                    </div>

                    <!-- Image Upload -->
                    <div class="mb-4">
                        <label for="imageFile" class="form-label fw-semibold">
                            Listing Image
                        </label>
                        <input
                            id="imageFile"
                            name="listingImage"
                            type="file"
                            class="form-control"
                            accept="image/jpeg,image/png,image/webp"
                        >
                        <div class="form-text">
                            JPG, PNG, or WebP. Maximum size: 5 MB.
                        </div>

                        <div
                            id="imageError"
                            class="text-danger small mt-2"
                            role="alert"
                        ></div>

                        <!-- Image Preview -->
                        <div id="previewContainer" class="mt-3 d-none">
                            <img
                                id="imagePreview"
                                alt="Selected listing image preview"
                                class="img-fluid rounded border"
                                style="max-height: 280px;"
                            >
                            <div>
                                <button
                                    type="button"
                                    id="removeImage"
                                    class="btn btn-outline-danger btn-sm mt-2"
                                >
                                    <i class="fa-solid fa-trash me-1"></i>
                                    Remove Image
                                </button>
                            </div>
                        </div>
                    </div>

                    <!-- Form Actions -->
                    <div class="d-flex flex-wrap gap-2">
                        <button type="submit" class="btn btn-dark">
                            <i class="fa-solid fa-cloud-arrow-up me-2"></i>
                            Create Listing
                        </button>

                        <a href="/listings" class="btn btn-outline-secondary">
                            Cancel
                        </a>
                    </div>

                </form>
            </div>
        </div>

    </div>
</div>

